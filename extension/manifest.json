{
  "manifest_version": 3,
  "name": "MAILicious",
  "version": "1.1.0",
  "description": "Checks each mail you open in Gmail and warns you before you reply, pay or click.",
  "permissions": ["storage"],
  "host_permissions": ["https://placementshield.vercel.app/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["https://mail.google.com/*"], "js": ["content.js"], "run_at": "document_idle" }],
  "action": { "default_popup": "popup.html", "default_icon": { "32": "icons/32.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
